# Caddy = the HTTPS front door of the dashboard.
#
# SITE_ADDRESS (from .env) is the address people open:
#   a domain name, e.g. 20-1-2-3.sslip.io  -> Caddy gets a free, trusted Let's Encrypt
#                                            certificate and renews it automatically
#                                            (ports 80 and 443 must be open to the internet)
#   localhost or an IP address             -> Caddy makes its own certificate; browsers show
#                                            a warning once ("connection not private")
#
# HTTPS matters because phones only allow the camera on secure pages, and because the
# dashboard password must not travel over the network in plain text.

{
	# Browsers don't say which site they want when the address is an IP; this tells Caddy
	# which certificate to use then. (Only needed for IPs; harmless for domain names.)
	default_sni {$SITE_ADDRESS}

	# HTTP/1.1 and HTTP/2 (no HTTP/3: the Azure firewall only opens TCP, HTTP/3 needs UDP).
	# HTTP/2 puts all requests on ONE connection, so the 6-connections-per-site limit of
	# HTTP/1.1 doesn't apply and every camera tile can stream video at once. dashboard.js
	# reads the MJPEG streams with fetch(), which works in Safari over HTTP/2 (an <img>
	# pointed at the stream does not).
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	# Normal HTTPS settings, written out so that default_sni above takes effect.
	tls {
		protocols tls1.2 tls1.3
	}
	# WebRTC signaling (the "offer/answer" requests that set up live video) goes to MediaMTX,
	# but only after the dashboard app said yes (login / phone token, see app/web/webrtc.py).
	handle_path /webrtc/* {
		forward_auth dashboard:8000 {
			uri /api/webrtc-auth
		}
		reverse_proxy mediamtx:8889
	}

	# Everything else: the dashboard app.
	handle {
		reverse_proxy dashboard:8000 {
			# Pass every response on immediately instead of buffering it.
			flush_interval -1
		}
	}
}
