# Copy this file to .env and fill it in:   cp .env.example .env
# docker compose reads .env automatically. Never commit .env (it is in .gitignore).
# On Azure, deploy/azure_setup.sh creates .env for you with random secrets.

# Address people open in the browser. On a server with a public IP like 20.1.2.3 use
# 20-1-2-3.sslip.io (free name that points to that IP) to get a trusted certificate.
SITE_ADDRESS=localhost

# Public IP of the server: browsers send/receive the WebRTC video there (UDP/TCP port 8189).
# deploy/azure_setup.sh fills it in. Locally: 127.0.0.1.
PUBLIC_IP=127.0.0.1

# Dashboard login. No password = dashboard open to everyone (only OK on your own laptop).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Secret that phones must know to stream. Empty = phone streaming switched off.
PHONE_TOKEN=change-me-too
